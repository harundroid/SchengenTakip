{
  "expo": {
    "name": "Schengen Rule Tracker",
    "slug": "SchengenApp",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "schengenapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0F172A"
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json",
      "bg": "./locales/bg.json",
      "el": "./locales/el.json",
      "mk": "./locales/mk.json"
    },
    "ios": {
      "bundleIdentifier": "com.harundroid.SchengenApp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon-and.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.harundroid.SchengenApp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SchengenApp to access your camera to scan QR codes for synchronizing trip data."
        }
      ],
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6682414535223145~1864483647",
          "iosAppId": "ca-app-pub-6682414535223145~3177565318"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
